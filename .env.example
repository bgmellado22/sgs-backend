# ==========================================
# SGS Backend - Plantilla de Variables de Entorno
# ==========================================
# Copiar este archivo a .env para desarrollo local si se utiliza Docker o gestor de entorno.

# Puerto del servidor
PORT=8080

# Conexión a MongoDB (Local o Mongo Atlas)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/sgs_db
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/sgs_db

# Clave Secreta para firma de Tokens JWT (Cadena Base64 de al menos 256 bits)
JWT_SECRET=tu_clave_base64_de_al_menos_256_bits_aqui

# Configuración SMTP (Gmail)
MAIL_USERNAME=sgs.eltabo.soporte@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_google_aqui
